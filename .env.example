# SimZakat Environment Configuration Template
# Salin file ini menjadi .env di server VPS: cp .env.example .env

PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# KONEKSI DATABASE MYSQL (VPS Ubuntu / Debian)
# -----------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=simzakat_user
MYSQL_PASSWORD=GantiDenganPasswordAmanMySQL2026!
MYSQL_DATABASE=simzakat_db

# -----------------------------------------------------------------------------
# APP URL & SECURITY
# -----------------------------------------------------------------------------
